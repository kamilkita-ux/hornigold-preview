// Hornigold — wdrożenie Cloudflare Workers (CloudMentor). Runbook: docs/CLOUDFLARE.md.
// Ten sam Worker co w Sites (server/worker.mjs), własne zasoby z prefiksem "hornigold-".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hornigold",
  "account_id": "ee23b9132a9692ab6c0e9f22aa86dda8", // konto Hornigold (osobne od FFP)
  "main": "server/worker.mjs",
  "compatibility_date": "2026-05-15",
  // www.hornigold.pl -> 301 regułą Redirect w strefie; stara strona PHP: old.hornigold.pl.
  "routes": [{ "pattern": "hornigold.pl", "custom_domain": true }],
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hornigold-counter",
      "database_id": "bb927207-d7e2-4ebf-bbfa-a540704d6495",
      "migrations_dir": "drizzle"
    }
  ],
  // Adres techniczny wyłączony po aktywacji strefy (9 października 2026 r.), jak w FFP.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
