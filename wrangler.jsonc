// Hornigold — wdrożenie Cloudflare Workers (CloudMentor). Runbook: docs/CLOUDFLARE.md.
// Ten sam Worker co w Sites (server/worker.mjs), własne zasoby z prefiksem "hornigold-".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hornigold",
  "account_id": "ee23b9132a9692ab6c0e9f22aa86dda8", // konto Hornigold (osobne od FFP)
  // Od 9.10.2026 produkcja z indeksowaniem (zgoda właściciela, docs/CLOUDFLARE_SEO_DEPLOYMENT_2026-10-09.md):
  // paczka scripts/prepare_cloudflare_production.py; production-entry.mjs zdejmuje noindex tylko na https://hornigold.pl.
  "main": "_cloudflare_production/server/production-entry.mjs",
  "compatibility_date": "2026-05-15",
  // Wykonywanie Workera w centrum danych Cloudflare najbliższym Warszawie (wskazówka, nie gwarancja).
  "placement": { "region": "gcp:europe-central2" },
  // www.hornigold.pl -> 301 regułą Redirect w strefie; stara strona PHP: old.hornigold.pl.
  "routes": [{ "pattern": "hornigold.pl", "custom_domain": true }],
  "assets": {
    "directory": "_cloudflare_production/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hornigold-counter-eu", // jurysdykcja EU (od 9.10.2026); stara hornigold-counter = kopia
      "database_id": "23c8ca98-7e50-4a5f-98a1-1a0bfbebde7e",
      "migrations_dir": "drizzle"
    }
  ],
  // Adres techniczny wyłączony po aktywacji strefy (9 października 2026 r.), jak w FFP.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
